[Desktop Entry]
Name=irontile
Comment=A Wayland tiling compositor
# start-irontile rather than irontile: a login manager signals and waits on the
# process it started, and that wants to be the supervisor, not the compositor
# it restarts. Named without a path so the entry works from either /usr/bin or
# /usr/local/bin; TryExec makes a login manager hide it if neither has one.
Exec=start-irontile
TryExec=start-irontile
Type=Application
Keywords=tiling;wayland;compositor;
# What xdg-desktop-portal matches against to pick a backend: a login manager
# turns this into XDG_CURRENT_DESKTOP, and the portal looks for a file named
# after it. Left out until there was a configuration for it to find, because
# naming a desktop with no portal configuration leaves file pickers and screen
# sharing with nothing to answer them; assets/portals/irontile-portals.conf is
# that configuration.
#
# desktop-file-validate rejects this key, and is wrong to: it belongs to session
# files rather than to application entries, and every session file on the
# machine carries it and fails the same check. sway and Hyprland included.
DesktopNames=irontile
