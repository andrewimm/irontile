# Maintainer: Andrew Imm <aimm22@gmail.com>
pkgname=irontile
pkgver=0.2.3
pkgrel=1
pkgdesc="A Wayland tiling compositor with a split-container tree as its native model"
arch=('x86_64')
url="https://github.com/andrewimm/irontile"
license=('MIT')
# Resolved from the sonames the binaries actually carry, rather than from what
# the compositor happens to use: mesa for gbm, libglvnd for the EGL that is
# opened by name at runtime, wayland for the two wayland client libraries that
# are opened the same way.
depends=('mesa' 'libinput' 'seatd' 'systemd-libs' 'libxkbcommon' 'libpulse' 'pam'
         'libglvnd' 'wayland')
makedepends=('cargo')
# check() renders text and resolves icon names, so it needs a font and an icon
# theme to be present. Neither is a runtime dependency of the compositor -- a
# bar with no font is the user's arrangement to make -- but a test suite that
# asserts what those look up cannot run without them, and a base image has
# nothing at all: no fonts, and no /usr/share/icons.
checkdepends=('noto-fonts' 'hicolor-icon-theme')
# Whether a separate -debug package is split out is a property of whichever
# makepkg.conf is in front of you -- Arch's default has it on, a stock container
# image does not -- so a build produces one package on one machine and two on
# another. Said here instead, so what comes out is the same everywhere.
options=(!debug)
# An upgrade leaves an edited PAM stack in place: what the lock screen asks for
# is the administrator's decision, and overwriting it could lock somebody out.
backup=('etc/pam.d/irontile-lock')
# Only the nested backend reaches for X, and that is for development rather than
# for running a session.
optdepends=('libxcb: running nested inside another compositor'
            'libx11: running nested inside another compositor'
            'libxcursor: running nested inside another compositor')

# Built from the checkout this file sits in, not from a downloaded release
# tarball, which is why there is nothing to name or checksum here.
#
# A tarball's checksum cannot be known until its tag exists, and pushing the tag
# is what starts the build -- so pinning one would mean committing a checksum
# for a file that does not exist yet. Packaging the tree directly also means the
# package is provably built from what was tagged rather than from something
# fetched back afterwards.
#
# An AUR recipe is the other way round and wants the tarball: it is written
# after a release exists, and lives in the AUR repository rather than here.
source=()

# $startdir is where makepkg was run, so this is the workspace around it.
_workspace() {
    cd "$startdir/.."
}

prepare() {
    _workspace
    # RUSTUP_TOOLCHAIN is not boilerplate here: the repo carries a
    # rust-toolchain.toml, which outranks whichever toolchain is default and
    # would otherwise decide the build on its own.
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    _workspace
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --all-features
}

check() {
    _workspace
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --frozen --all-features
}

package() {
    _workspace
    install -Dm755 target/release/irontile "$pkgdir/usr/bin/irontile"
    install -Dm755 target/release/irontile-bar "$pkgdir/usr/bin/irontile-bar"
    install -Dm755 target/release/irontilectl "$pkgdir/usr/bin/irontilectl"
    install -Dm755 target/release/irontile-lock "$pkgdir/usr/bin/irontile-lock"
    install -Dm755 target/release/start-irontile "$pkgdir/usr/bin/start-irontile"
    # What makes irontile appear in a login manager's session list.
    install -Dm644 assets/irontile.desktop \
        "$pkgdir/usr/share/wayland-sessions/irontile.desktop"
    # Without this the lock screen authenticates nothing, which is the safe way
    # round for a file that decides who gets back into the session.
    install -Dm644 assets/pam/arch "$pkgdir/etc/pam.d/irontile-lock"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
